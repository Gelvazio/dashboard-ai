# =============================================================================
# DashboardAI — variáveis de ambiente (modelo)
# =============================================================================
# Copie este arquivo para `.env` (scripts e funções serverless) ou `.env.local`
# (frontend com Vite) e preencha os valores do SEU projeto.
#
# NUNCA commite valores reais: `.env` e `.env.*` estão no `.gitignore`; só este
# modelo (`.env.example`) vai para o Git, sempre com valores vazios.
#
# Onde cada variável é lida:
#   - `VITE_*`  -> embutidas no bundle do navegador (públicas). Só coloque aqui
#                  o que pode ser visto por qualquer pessoa (ex.: chave anon).
#   - demais    -> só no servidor (funções em `api/`, scripts em `scripts/`).
#                  Chaves secretas (service_role, OpenAI, token do MCP) NUNCA
#                  podem ter o prefixo `VITE_`.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (navegador)
# -----------------------------------------------------------------------------
# Lidas pelo Vite (`import.meta.env`) e embutidas no bundle: são públicas.
# URL do projeto Supabase (Settings > API).
VITE_SUPABASE_URL=
# Chave **anon** (pública). NUNCA a service_role: o `getSupabase()` recusa
# chaves service_role aqui. Todo acesso é decidido pela RLS + login do usuário.
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Servidor Supabase (somente servidor/scripts)
# -----------------------------------------------------------------------------
# URL do projeto (Settings > API). Usada por `api/` e `scripts/`.
SUPABASE_URL=
# Chave service_role: ignora a RLS. SÓ servidor/scripts (MCP, sincronizar_tasks.py).
# NUNCA use o prefixo VITE_ nem a coloque no frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Chave anon (pública): valida a sessão do usuário em POST /api/embedding (SUB-33.2).
SUPABASE_ANON_KEY=
# Opcional: só para testes locais com PostgREST (ex.: http://localhost:3000).
# Em produção fica vazia e usa ${SUPABASE_URL}/rest/v1.
SUPABASE_REST_URL=

# -----------------------------------------------------------------------------
# Embeddings (somente servidor)
# -----------------------------------------------------------------------------
# Usadas por `api/_lib/embeddings.ts` (MCP `brain_store`/`brain_search` e POST /api/embedding).
# Chave da API de embeddings. SÓ servidor: nunca com prefixo VITE_.
OPENAI_API_KEY=
# Opcional: endpoint compatível com a OpenAI (padrão https://api.openai.com/v1/embeddings).
EMBEDDING_API_URL=
# Opcional: modelo (padrão text-embedding-3-small). O vetor precisa ter 1536
# dimensões (coluna ai_memories.embedding vector(1536)).
EMBEDDING_MODEL=

# -----------------------------------------------------------------------------
# MCP (somente servidor)
# -----------------------------------------------------------------------------
# Token exigido em `Authorization: Bearer <token>` no endpoint /mcp. Sem ele, as
# ferramentas de dados (fila e memória) ficam desativadas, pois o servidor usa a
# service_role. Gere com: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Origem liberada no CORS (padrão `*`). Em produção, restrinja à URL do dashboard.
MCP_CORS_ORIGIN=
# URL do endpoint /mcp lida pelo `.mcp.json` do Claude Code (variável do CLIENTE,
# não do servidor). Ex.: https://seu-app.vercel.app/mcp
DASHBOARD_AI_MCP_URL=
# Slug do projeto usado quando a ferramenta não recebe `project`.
MCP_DEFAULT_PROJECT=
# Opcional: slugs permitidos, separados por vírgula (ex.: projeto-a,projeto-b).
# Quando preenchida, só esses projetos são aceitos e memória global é recusada.
MCP_ALLOWED_PROJECTS=

# -----------------------------------------------------------------------------
# Scripts
# -----------------------------------------------------------------------------
# `scripts/sincronizar_tasks.py` lê o `.env` da raiz (sem sobrescrever variáveis
# já definidas) e usa SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (seção do servidor).
# Opcional: slug do projeto padrão (equivale a --projeto; padrão `default`).
DASHBOARD_AI_PROJECT=

# Opcional: limite (KB) por chunk em `npm run check:chunks` (padrão 500).
CHUNK_LIMITE_KB=

# Worker LangGraph: Postgres dos checkpoints (schema `langgraph`). Só no servidor.
LANGGRAPH_DATABASE_URL=
# Opcional: modelo do worker (ChatOpenAI, usa OPENAI_API_KEY; padrão gpt-4o-mini).
WORKER_MODELO=
# Classificador do worker (SUB-47.1): Laya Server. Só no servidor (nunca com prefixo VITE_).
# URL base do laya-serve (docker-compose.laya.yml); padrão http://localhost:8000.
LAYA_SERVER_URL=
# Opcional: a mesma chave do LAYA_API_KEY do serviço, quando ele exige bearer.
LAYA_API_KEY=
# Opcional: tempo máximo por chamada, em ms (padrão 60000; a 1ª pode baixar os pesos).
LAYA_TIMEOUT_MS=
# Fallback com Opus do classificador (SUB-47.14). SECRETA: só no servidor, nunca VITE_.
ANTHROPIC_API_KEY=
# Opcional: modelo do fallback (padrão claude-opus-5-5) e tempo máximo em ms (padrão 60000).
OPUS_MODELO=
OPUS_TIMEOUT_MS=
