{
  "name": "dashboard-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Gerenciador genérico de tasks de IA multi-projeto: fila, memória persistente e monitor do agendador.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p api/tsconfig.json",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "test": "vitest run",
    "test:integration": "bash tests/integration/run.sh",
    "check:env": "node scripts/checar-env.mjs",
    "validar": "bash scripts/validar.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
