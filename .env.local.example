# =============================================================================
# DashboardAI — variáveis do Supabase LOCAL (Docker) — MODELO
# =============================================================================
# Copie para `.env.local` e preencha as chaves. O jeito mais fácil é:
#
#   npm run dev:local      # cria o .env.local (se faltar) e sobe o Vite com ele
#   node scripts/alternar-env.mjs status   # mostra qual ambiente está ativo
#
# Chaves do stack local (com ele no ar):
#
#   npx supabase --workdir database/configlocal status
#
# NUNCA commite valores reais: `.env` e `.env.*` estão no `.gitignore`; só os
# MODELOS (`.env.example` e `.env.local.example`) vão para o Git, com valores vazios.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (navegador) — lidas pelo Vite (`import.meta.env`), são públicas
# -----------------------------------------------------------------------------
# API do Supabase local (porta [api] do config.toml).
VITE_SUPABASE_URL=http://localhost:54321
# Chave anon local (pública). NUNCA a service_role: o `getSupabase()` recusa.
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Servidor (`api/`, `worker/`, `scripts/`) — nunca com prefixo VITE_
# -----------------------------------------------------------------------------
SUPABASE_URL=http://localhost:54321
# Ignora a RLS. Só servidor/scripts.
SUPABASE_SERVICE_ROLE_KEY=
# Valida a sessão do usuário em POST /api/embedding (SUB-33.2).
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Banco local (worker LangGraph)
# -----------------------------------------------------------------------------
# Postgres do Supabase local (porta [db] do config.toml).
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Checkpoints do worker (mesmo banco local; schema `langgraph`).
LANGGRAPH_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# -----------------------------------------------------------------------------
# Opcional: testes de integração contra o stack local
# -----------------------------------------------------------------------------
# `npm run test:integration` sobe o próprio PostgREST; deixe vazio para usá-lo.
SUPABASE_REST_URL=
