{
  "name": "dashboard-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Gerenciador genérico de tasks de IA multi-projeto: fila, memória persistente e monitor do agendador.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p api/tsconfig.json",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "test:integration": "bash tests/integration/run.sh",
    "check:env": "node scripts/checar-env.mjs",
    "validar": "bash scripts/validar.sh",
    "check:chunks": "node scripts/checar-chunks.mjs",
    "sync:agentes": "node scripts/sincronizar-agentes.mjs",
    "worker": "tsx worker/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.37",
    "@langchain/langgraph-checkpoint-postgres": "^0.1.3",
    "@langchain/openai": "^0.4.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chart.js": "^2.9.41",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.29",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zod": "^3.24.2"
  },
  "overrides": {
    "langsmith": "^0.6.0"
  }
}
